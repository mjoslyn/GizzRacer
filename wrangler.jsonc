{
  // GizzRacer on Cloudflare: one Worker serves the built game (dist/) and
  // routes /parties/* to the PartyKit servers (docs/MULTIPLAYER.md).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gizzracer",
  "main": "party/index.ts",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      { "name": "Players", "class_name": "Players" },
      { "name": "Trials", "class_name": "Trials" },
      { "name": "Room", "class_name": "Room" },
      { "name": "Records", "class_name": "Records" },
      { "name": "Couch", "class_name": "Couch" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Players", "Trials"] },
    { "tag": "v2", "new_sqlite_classes": ["Room"] },
    { "tag": "v3", "new_sqlite_classes": ["Records"] },
    { "tag": "v4", "new_sqlite_classes": ["Couch"] }
  ]
}
